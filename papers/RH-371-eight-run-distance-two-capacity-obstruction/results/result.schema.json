{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "route_verdict", "gates", "false_claims", "source_audit", "finite_checks", "periodic_audit"],
  "properties": {
    "status": {"const": "RH-371_eight_run_distance_two_capacity_obstruction"},
    "route_verdict": {
      "type": "object",
      "required": ["route_a", "route_b"],
      "properties": {"route_a": {"const": "GO"}, "route_b": {"const": "STOP_SCOPED"}}
    },
    "gates": {"type": "object", "additionalProperties": {"const": false}},
    "false_claims": {"type": "object", "additionalProperties": {"const": false}},
    "source_audit": {
      "type": "object",
      "required": ["pass", "rows"],
      "properties": {"pass": {"const": true}, "rows": {"type": "array", "minItems": 9}}
    },
    "finite_checks": {
      "type": "object",
      "required": ["all_pass", "prefix_formula_pass", "endpoint_pass", "pair_ledger_pass"],
      "properties": {"all_pass": {"const": true}, "prefix_formula_pass": {"const": true}, "endpoint_pass": {"const": true}, "pair_ledger_pass": {"const": true}}
    },
    "periodic_audit": {
      "type": "object",
      "required": ["cyclic_ledger_equal", "open_lag2_differs"],
      "properties": {"cyclic_ledger_equal": {"const": true}, "open_lag2_differs": {"const": true}}
    }
  }
}
