    "fixed_clock_optimum_scope": "universally safe one-site phase/current-input factors at fixed q_y",
    "q900_improvement_over_rh373": "1/(24*pi^2)",
    "quantifier": "fix y before N tends to infinity; one scalar liminf dominates all B_y",
    "recurrence": "A'=(p^2-1)A; O'=(p^2-1)O+L_even",
    "run_formula": "O_y=P_y*sum_{j in {1,3,5,7}}(E_j-2*E_(j+1)+E_(j+2))",
    "strict_monotonicity": true
  }
