{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/tpc141-batch-manifest-v1.json",
  "title": "TPC-141 source-locked batch manifest",
  "type": "object",
  "required": [
    "schema",
    "snapshot",
    "source_bundles",
    "scope_registry",
    "exports",
    "imports",
    "nodes",
    "proof_dag",
    "terminal_leaf_coverage",
    "tail_namespaces",
    "occurrence_registry",
    "endpoint_ledger",
    "route_universe",
    "gate_projection",
    "first_missing",
    "cut_aware_bound",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "tpc-141-source-locked-batch-manifest-v1"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "date",
        "source_range",
        "selected_route",
        "source_hash_semantics",
        "restricted_positive_arithmetic_shadow",
        "exceptional_window_state"
      ],
      "properties": {
        "date": {"type": "string"},
        "source_range": {"const": "TPC-133--140"},
        "selected_route": {"type": "string"},
        "source_hash_semantics": {"const": "INTEGRITY_ONLY"},
        "restricted_positive_arithmetic_shadow": {
          "const": "SMALL_POLYLOG_AFFINE_ALMOST_SCALE"
        },
        "exceptional_window_state": {
          "const": "GLOBAL_DENSITY_PROVED_LOCAL_ACTUAL_WINDOW_OPEN"
        }
      }
    },
    "source_bundles": {
      "type": "object",
      "minProperties": 8
    },
    "scope_registry": {
      "type": "object",
      "minProperties": 3
    },
    "exports": {
      "type": "array",
      "minItems": 8
    },
    "imports": {
      "type": "array"
    },
    "nodes": {
      "type": "array",
      "minItems": 9
    },
    "proof_dag": {
      "type": "object",
      "required": ["parents", "topological_order", "root"]
    },
    "terminal_leaf_coverage": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "tail_namespaces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "occurrence_registry": {
      "type": "object",
      "required": [
        "primitive_occurrences",
        "joint_tokens",
        "retained_occurrences",
        "complete"
      ]
    },
    "endpoint_ledger": {
      "type": "object",
      "required": [
        "contract",
        "sigma_target",
        "sigma_shadow_power",
        "sigma_actual_certified",
        "lambda_phys_upper",
        "lambda_phys_lower",
        "state"
      ]
    },
    "route_universe": {
      "type": "object",
      "required": ["routes", "selected_route", "stops"]
    },
    "gate_projection": {
      "type": "object",
      "minProperties": 9
    },
    "first_missing": {
      "type": "object",
      "required": [
        "node_id",
        "gate",
        "status",
        "program_level",
        "required_artifact"
      ]
    },
    "cut_aware_bound": {
      "type": "object",
      "required": [
        "identity",
        "soft",
        "bound",
        "frontier_explicit",
        "coverage",
        "full_carrier_totalized"
      ]
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "source_hashes_prove_theorems",
        "cut_complete_is_full_carrier",
        "arithmetic_frontier",
        "positive_L2",
        "strict_endpoint",
        "endpoint_pass",
        "hard_packet_oX",
        "prime_pair_theorem",
        "twin_prime_theorem"
      ]
    }
  },
  "additionalProperties": false
}
