{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rational": {
      "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "euler_value": {
      "additionalProperties": false,
      "properties": {
        "inv_pi2": {"$ref": "#/$defs/rational"},
        "kappa2": {"$ref": "#/$defs/rational"}
      },
      "required": ["inv_pi2", "kappa2"],
      "type": "object"
    },
    "diagnostic_interval": {
      "additionalProperties": false,
      "properties": {
        "label": {"const": "diagnostic_only"},
        "lower": {"pattern": "^-?[0-9]+\\.[0-9]+$", "type": "string"},
        "upper": {"pattern": "^-?[0-9]+\\.[0-9]+$", "type": "string"}
      },
      "required": ["label", "lower", "upper"],
      "type": "object"
    },
    "density_aggregation_row": {
      "additionalProperties": false,
      "properties": {
        "Q": {"minimum": 1, "type": "integer"},
        "all_pass": {"const": true},
        "delta_aggregation_pass": {"const": true},
        "fiber_size": {"minimum": 1, "type": "integer"},
        "q": {"minimum": 1, "type": "integer"},
        "residue_count": {"minimum": 1, "type": "integer"},
        "theta_aggregation_pass": {"const": true}
      },
      "required": [
        "Q",
        "all_pass",
        "delta_aggregation_pass",
        "fiber_size",
        "q",
        "residue_count",
        "theta_aggregation_pass"
      ],
      "type": "object"
    },
    "density_normalization_row": {
      "additionalProperties": false,
      "properties": {
        "pass": {"const": true},
        "q": {"minimum": 1, "type": "integer"},
        "sum_kappa2_theta_coefficient": {"const": "1"},
        "sum_pi2_delta": {"const": "6"}
      },
      "required": [
        "pass",
        "q",
        "sum_kappa2_theta_coefficient",
        "sum_pi2_delta"
      ],
      "type": "object"
    },
    "fixed_clock_row": {
      "additionalProperties": false,
      "properties": {
        "G": {"$ref": "#/$defs/euler_value"},
        "action_counts": {
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "0": {"minimum": 0, "type": "integer"},
            "I": {"minimum": 0, "type": "integer"},
            "J": {"minimum": 0, "type": "integer"}
          },
          "type": "object"
        },
        "action_sha256": {"$ref": "#/$defs/sha256"},
        "all_pass": {"const": true},
        "cyclic_compatibility_pass": {"const": true},
        "diagnostic_interval": {"$ref": "#/$defs/diagnostic_interval"},
        "expected_fixture": {"$ref": "#/$defs/euler_value"},
        "expected_fixture_pass": {"const": true},
        "formula": {"minLength": 1, "type": "string"},
        "independent_set_crosscheck_pass": {"const": true},
        "independent_set_reduction": {"$ref": "#/$defs/euler_value"},
        "max_plus_comparisons": {"minimum": 0, "type": "integer"},
        "q": {"minimum": 1, "type": "integer"}
