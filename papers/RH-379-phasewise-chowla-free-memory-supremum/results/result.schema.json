        "even_run_bound": {"minLength": 1, "type": "string"},
        "mathcal_E_y": {"minimum": 1, "type": "integer"},
        "primes": {
          "items": {"minimum": 3, "type": "integer"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
