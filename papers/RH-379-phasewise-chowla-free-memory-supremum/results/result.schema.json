      "required": [
        "A_y",
        "B_y",
        "D_y",
        "Delta_limit_mechanism",
        "Delta_y",
        "G_formula",
        "G_formula_text",
        "H_limit",
        "O_y",
        "P_y",
        "a_half_lt_b_lt_a",
        "a_y",
        "all_pass",
        "b_y_pair_weight",
        "direct_dp",
        "direct_dp_pass",
        "even_run_bound",
        "mathcal_E_y",
        "primes",
        "q_y",
        "run_counts",
        "run_recurrence",
        "run_recurrence_rows",
        "strict_gain",
        "y"
