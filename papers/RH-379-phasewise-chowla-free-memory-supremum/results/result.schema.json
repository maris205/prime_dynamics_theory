      "required": [
        "G",
        "action_counts",
        "action_sha256",
        "all_pass",
        "cyclic_compatibility_pass",
        "diagnostic_interval",
        "expected_fixture",
        "expected_fixture_pass",
        "formula",
        "independent_set_crosscheck_pass",
