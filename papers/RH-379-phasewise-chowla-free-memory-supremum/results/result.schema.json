        "run_recurrence": {"minLength": 1, "type": "string"},
        "run_recurrence_rows": {
          "items": {"$ref": "#/$defs/run_recurrence_row"},
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "strict_gain": {"const": true},
        "y": {"minimum": 1, "type": "integer"}
