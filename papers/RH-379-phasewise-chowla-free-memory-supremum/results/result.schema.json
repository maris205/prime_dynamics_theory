        "q_y": {"minimum": 1, "type": "integer"},
        "run_counts": {
          "additionalProperties": false,
          "properties": {
            "1": {"minimum": 0, "type": "integer"},
            "2": {"minimum": 0, "type": "integer"},
            "3": {"minimum": 0, "type": "integer"},
            "4": {"minimum": 0, "type": "integer"},
            "5": {"minimum": 0, "type": "integer"},
            "6": {"minimum": 0, "type": "integer"},
            "7": {"minimum": 0, "type": "integer"},
            "8": {"minimum": 0, "type": "integer"}
