{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tpc166-refined-h1-frontier-v1.schema.json",
  "title": "TPC-166 refined H1 crosswalk frontier decision",
  "type": "object",
  "required": [
    "schema",
    "source_locks",
    "historical_pointer",
    "refinement_scope",
    "refined_dag",
    "minimal_not_testable_root_antichain",
    "selection",
    "production_evidence",
    "current_decision",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "tpc-166-refined-h1-crosswalk-frontier-v1"
    },
    "source_locks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9
    },
    "historical_pointer": {
      "type": "object",
      "required": [
        "source",
        "frozen_first_missing",
        "retroactively_rewritten"
      ]
    },
    "refinement_scope": {
      "type": "object",
      "required": [
        "target_subdag",
        "is_full_H1_map_clause",
        "is_full_H1_minimal_blocker_antichain",
        "full_map_clause_additional_requirements",
        "scalar_plus_ETO_clause_status"
      ]
    },
    "refined_dag": {
      "type": "object",
      "required": [
        "target",
        "nodes",
        "acyclic",
        "dependency_direction"
      ]
    },
    "minimal_not_testable_root_antichain": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    },
    "selection": {
      "type": "object"
    },
    "production_evidence": {
      "type": "object"
    },
    "current_decision": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
