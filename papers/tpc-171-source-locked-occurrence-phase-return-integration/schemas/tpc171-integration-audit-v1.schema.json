{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tpc171-integration-audit-v1.schema.json",
  "title": "TPC-171 source-locked integration audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "manifest_sha256",
    "checks",
    "mutation_regressions",
    "current_verdict",
    "first_missing",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "tpc-171-source-locked-occurrence-phase-return-audit-v1"
    },
    "status": {
      "const": "PASS"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "object"
    },
    "mutation_regressions": {
      "type": "object"
    },
    "current_verdict": {
      "const": "NOT_TESTABLE"
    },
    "first_missing": {
      "type": "string"
    },
    "claim_boundary": {
      "type": "object"
    }
  }
}
