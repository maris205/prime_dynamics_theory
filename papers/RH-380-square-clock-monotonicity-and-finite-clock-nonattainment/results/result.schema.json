{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/RH-380/result.schema.json",
  "title": "RH-380 exact result ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "source_locks",
    "source_commits",
    "predecessor_checks",
    "certificate",
    "theorem",
    "claim_boundary",
    "gates"
  ],
  "properties": {
    "status": {
      "const": "RH-380_square_clock_monotonicity_and_finite_clock_nonattainment"
    },
    "source_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "entries", "release_blob_identity_pass", "pass"],
      "properties": {
        "count": {"const": 24},
        "entries": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceLock"}
        },
        "release_blob_identity_pass": {"const": true},
        "pass": {"const": true}
      }
    },
    "source_commits": {"$ref": "#/$defs/sourceCommits"},
    "predecessor_checks": {"$ref": "#/$defs/predecessorChecks"},
    "certificate": {"$ref": "#/$defs/certificate"},
    "theorem": {"$ref": "#/$defs/theorem"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "gates": {"$ref": "#/$defs/gates"}
  },
  "$defs": {
    "fraction": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"
    },
    "euler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inv_pi2", "kappa2"],
      "properties": {
        "inv_pi2": {"$ref": "#/$defs/fraction"},
        "kappa2": {"$ref": "#/$defs/fraction"}
      }
    },
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "release"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release": {
          "enum": ["rh374_release", "rh375_release", "rh379_release", "rh_mvp2_archive"]
        }
      }
    },
    "sourceCommits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rh374_release", "rh375_release", "rh379_release", "rh_mvp2_archive"],
      "properties": {
        "rh374_release": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rh375_release": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rh379_release": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "rh_mvp2_archive": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q36", "q180", "q900", "q180_minus_q36", "scope",
        "sign_from_h_upper_bound_pass", "pass"
      ],
      "properties": {
        "q36": {"$ref": "#/$defs/euler"},
        "q180": {"$ref": "#/$defs/euler"},
        "q900": {"$ref": "#/$defs/euler"},
        "q180_minus_q36": {"$ref": "#/$defs/euler"},
        "scope": {"type": "string"},
        "sign_from_h_upper_bound_pass": {"const": true},
        "pass": {"const": true}
      }
    },
    "predecessorChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rh379_status",
        "h_interval_from_rh379",
        "coarse_h_interval",
        "h_enclosure_pass",
        "negative_control",
        "all_pass"
      ],
      "properties": {
        "rh379_status": {"const": "RH-379_phasewise_chowla_free_memory_supremum"},
        "h_interval_from_rh379": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/fraction"}
        },
        "coarse_h_interval": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/fraction"}
        },
        "h_enclosure_pass": {"const": true},
        "negative_control": {"$ref": "#/$defs/negativeControl"},
        "all_pass": {"const": true}
      }
    },
    "deletionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s", "observed", "expected", "pass"],
      "properties": {
        "s": {"type": "integer", "minimum": 1},
        "observed": {"type": "integer", "minimum": 0},
        "expected": {"type": "integer", "minimum": 0},
        "pass": {"const": true}
      }
    },
    "deletionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "parity", "expected_formula", "checks", "all_pass"],
      "properties": {
        "length": {"type": "integer", "minimum": 1, "maximum": 8},
        "parity": {"enum": ["odd", "even"]},
        "expected_formula": {"enum": ["ell-1", "s-2"]},
        "checks": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/deletionCheck"}
        },
        "all_pass": {"const": true}
      }
    },
    "runHistogram": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "1": {"type": "integer", "minimum": 0},
        "2": {"type": "integer", "minimum": 0},
        "3": {"type": "integer", "minimum": 0},
        "4": {"type": "integer", "minimum": 0},
        "5": {"type": "integer", "minimum": 0},
        "6": {"type": "integer", "minimum": 0},
        "7": {"type": "integer", "minimum": 0},
        "8": {"type": "integer", "minimum": 0}
      }
    },
    "directRunRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["y", "direct", "formula", "pass"],
      "properties": {
        "y": {"type": "integer", "minimum": 1},
        "direct": {"$ref": "#/$defs/runHistogram"},
        "formula": {"$ref": "#/$defs/runHistogram"},
        "pass": {"const": true}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "y", "next_prime", "s", "A_y", "D_y", "O_y", "mathcal_E_y", "L_y", "M_y",
        "L_minus_2E", "R8_y", "mathcal_E_next", "mathcal_E_recurrence_rhs",
        "mathcal_E_recurrence_pass", "O_next", "O_recurrence_rhs", "O_recurrence_pass",
        "A_recurrence_pass", "D_recurrence_pass", "G_y", "G_next", "increment_direct",
        "increment_formula", "increment_identity_pass", "quantitative_lower_inv_pi2",
        "persistent_R8_pass", "X_at_least_6_pass", "M_nonnegative_pass", "strictness_basis", "all_pass"
      ],
      "properties": {
        "y": {"type": "integer", "minimum": 1},
        "next_prime": {"type": "integer", "minimum": 3},
        "s": {"type": "integer", "minimum": 9},
        "A_y": {"type": "integer", "minimum": 1},
        "D_y": {"type": "integer", "minimum": 1},
        "O_y": {"type": "integer", "minimum": 0},
        "mathcal_E_y": {"type": "integer", "minimum": 0},
        "L_y": {"type": "integer", "minimum": 0},
        "M_y": {"type": "integer", "minimum": 0},
        "L_minus_2E": {"type": "integer", "minimum": 6},
        "R8_y": {"type": "integer", "minimum": 1},
        "mathcal_E_next": {"type": "integer", "minimum": 0},
        "mathcal_E_recurrence_rhs": {"type": "integer", "minimum": 0},
        "mathcal_E_recurrence_pass": {"const": true},
        "O_next": {"type": "integer", "minimum": 0},
        "O_recurrence_rhs": {"type": "integer", "minimum": 0},
        "O_recurrence_pass": {"const": true},
        "A_recurrence_pass": {"const": true},
        "D_recurrence_pass": {"const": true},
        "G_y": {"$ref": "#/$defs/euler"},
        "G_next": {"$ref": "#/$defs/euler"},
        "increment_direct": {"$ref": "#/$defs/euler"},
        "increment_formula": {"$ref": "#/$defs/euler"},
        "increment_identity_pass": {"const": true},
        "quantitative_lower_inv_pi2": {"$ref": "#/$defs/fraction"},
        "persistent_R8_pass": {"const": true},
        "X_at_least_6_pass": {"const": true},
        "M_nonnegative_pass": {"const": true},
        "strictness_basis": {"type": "string"},
        "all_pass": {"const": true}
      }
    },
    "separatorCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parity", "length", "zero_sites", "not_all_supported_pass",
        "mod4_zero_cause_pass", "mod9_zero_cause_pass", "cause_specific_pass"
      ],
      "properties": {
        "parity": {"enum": ["odd", "even"]},
        "length": {"type": "integer", "minimum": 1},
        "zero_sites": {"type": "integer", "minimum": 1},
        "not_all_supported_pass": {"const": true},
        "mod4_zero_cause_pass": {"type": "boolean"},
        "mod9_zero_cause_pass": {"type": "boolean"},
        "cause_specific_pass": {"const": true}
      }
    },
    "separatorCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycles", "even_mod4_separator_pass", "odd_mod9_separator_pass", "all_pass"],
      "properties": {
        "cycles": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/separatorCycle"}
        },
        "even_mod4_separator_pass": {"const": true},
        "odd_mod9_separator_pass": {"const": true},
        "all_pass": {"const": true}
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "y", "multiplier", "q_y", "Q", "prime_support", "same_support_pass",
        "delta_scale_inv_pi2", "theta_scale_kappa2", "fine_residue_count",
        "delta_scaling_pass", "theta_scaling_pass", "density_scaling_pass",
        "base_run_histogram", "fine_run_histogram", "run_replication_pass",
        "base_separator_certificate", "fine_separator_certificate", "maximum_run_length",
        "G_Q", "G_q_y", "saturation_pass", "direct_dp_G_Q", "direct_dp_comparisons",
        "direct_dp_pass", "all_pass"
      ],
      "properties": {
        "y": {"type": "integer", "minimum": 1},
        "multiplier": {"type": "integer", "minimum": 1},
        "q_y": {"type": "integer", "minimum": 1},
        "Q": {"type": "integer", "minimum": 1},
        "prime_support": {
          "type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 2}
        },
        "same_support_pass": {"const": true},
        "delta_scale_inv_pi2": {"$ref": "#/$defs/fraction"},
        "theta_scale_kappa2": {"$ref": "#/$defs/fraction"},
        "fine_residue_count": {"type": "integer", "minimum": 1},
        "delta_scaling_pass": {"const": true},
        "theta_scaling_pass": {"const": true},
        "density_scaling_pass": {"const": true},
        "base_run_histogram": {"$ref": "#/$defs/runHistogram"},
        "fine_run_histogram": {"$ref": "#/$defs/runHistogram"},
        "run_replication_pass": {"const": true},
        "base_separator_certificate": {"$ref": "#/$defs/separatorCertificate"},
        "fine_separator_certificate": {"$ref": "#/$defs/separatorCertificate"},
        "maximum_run_length": {"type": "integer", "minimum": 1, "maximum": 8},
        "G_Q": {"$ref": "#/$defs/euler"},
        "G_q_y": {"$ref": "#/$defs/euler"},
        "saturation_pass": {"const": true},
        "direct_dp_G_Q": {"$ref": "#/$defs/euler"},
        "direct_dp_comparisons": {"type": "integer", "minimum": 1},
        "direct_dp_pass": {"const": true},
        "all_pass": {"const": true}
      }
    },
    "gapRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q", "y", "q_y", "Q", "q_divides_Q", "q_y_divides_Q",
        "same_support_as_q_y", "gap_lower_inv_pi2", "gap_statement", "all_pass"
      ],
      "properties": {
        "q": {"type": "integer", "minimum": 1},
        "y": {"type": "integer", "minimum": 1},
        "q_y": {"type": "integer", "minimum": 1},
        "Q": {"type": "integer", "minimum": 1},
        "q_divides_Q": {"const": true},
        "q_y_divides_Q": {"const": true},
        "same_support_as_q_y": {"const": true},
        "gap_lower_inv_pi2": {"$ref": "#/$defs/fraction"},
        "gap_statement": {"type": "string"},
        "all_pass": {"const": true}
      }
    },
    "certificateBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_finite_q_before_N_limit", "phasewise_c11_zero_only",
        "absolute_value_uses_RH379_input_reflection", "delta_y_monotonicity_not_claimed",
        "general_cover_saturation_not_claimed", "growing_clock_not_claimed",
        "adaptive_capacity_convergence_not_claimed", "gates_A_through_E"
      ],
      "properties": {
        "fixed_finite_q_before_N_limit": {"const": true},
        "phasewise_c11_zero_only": {"const": true},
        "absolute_value_uses_RH379_input_reflection": {"const": true},
        "delta_y_monotonicity_not_claimed": {"const": true},
        "general_cover_saturation_not_claimed": {"const": true},
        "growing_clock_not_claimed": {"const": true},
        "adaptive_capacity_convergence_not_claimed": {"const": true},
        "gates_A_through_E": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {"const": false}
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deletion_ledger", "direct_run_rows", "square_transitions",
        "same_support_saturation", "lcm_gap_rows", "locked_statistics_pass",
        "increment_fixtures_pass", "claim_boundary", "all_pass"
      ],
      "properties": {
        "deletion_ledger": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {"$ref": "#/$defs/deletionRow"}
        },
        "direct_run_rows": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/directRunRow"}
        },
        "square_transitions": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"$ref": "#/$defs/transition"}
        },
        "same_support_saturation": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": {"$ref": "#/$defs/saturation"}
        },
        "lcm_gap_rows": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {"$ref": "#/$defs/gapRow"}
        },
        "locked_statistics_pass": {"const": true},
        "increment_fixtures_pass": {"const": true},
        "claim_boundary": {"$ref": "#/$defs/certificateBoundary"},
        "all_pass": {"const": true}
      }
    },
    "theorem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_class", "even_run_recurrence", "increment", "strictness",
        "special_saturation", "finite_clock_nonattainment", "explicit_gap", "absolute_optimum"
      ],
      "properties": {
        "factor_class": {"type": "string"},
        "even_run_recurrence": {"type": "string"},
        "increment": {"type": "string"},
        "strictness": {"type": "string"},
        "special_saturation": {"type": "string"},
        "finite_clock_nonattainment": {"type": "string"},
        "explicit_gap": {"type": "string"},
        "absolute_optimum": {"type": "string"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_a", "route_b", "first_unresolved_object", "notes"],
      "properties": {
        "route_a": {"const": "GO"},
        "route_b": {"const": "STOP_SCOPED"},
        "first_unresolved_object": {"type": "string"},
        "notes": {"type": "array", "minItems": 7, "items": {"type": "string"}}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A_canonical_intrinsic_dynamical_spectral_determinant",
        "B_time_oriented_scattering_or_unitary_completion",
        "C_self_adjoint_generator_and_intrinsic_T_log_T",
        "D_von_mangoldt_weighted_prime_power_traces",
        "E_completed_zeta_divisor_equality"
      ],
      "properties": {
        "A_canonical_intrinsic_dynamical_spectral_determinant": {"const": false},
        "B_time_oriented_scattering_or_unitary_completion": {"const": false},
        "C_self_adjoint_generator_and_intrinsic_T_log_T": {"const": false},
        "D_von_mangoldt_weighted_prime_power_traces": {"const": false},
        "E_completed_zeta_divisor_equality": {"const": false}
      }
    }
  }
}
