{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tpc148-quotient-lift-v1.schema.json",
  "title": "TPC-148 quotient-Mobius lift record",
  "type": "object",
  "required": [
    "c",
    "definition",
    "multiplicative",
    "completely_multiplicative",
    "identity",
    "prime_modification_set"
  ],
  "properties": {
    "c": {"type": "integer", "minimum": 1},
    "definition": {"const": "LOCAL_PRIME_POWER"},
    "multiplicative": {"const": true},
    "completely_multiplicative": {"const": false},
    "identity": {"const": "G_c(c*m)=mu(m)"},
    "prime_modification_set": {
      "type": "array",
      "items": {"type": "integer", "minimum": 2},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
